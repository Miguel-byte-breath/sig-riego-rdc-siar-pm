{
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "api/*.js", "use": "@vercel/node", "config": { "includeFiles": "*.json" } },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/calcular-riego", "dest": "/api/calcular-riego.js" },
    { "src": "/api/siar_mensual",   "dest": "/api/siar_mensual.py" },
    { "src": "/api/ping",           "dest": "/api/ping.py" },
    { "src": "/(.*)",               "dest": "/$1" }
  ]
}
